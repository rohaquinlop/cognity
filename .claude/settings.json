{
  "permissions": {
    "allow": [
      "Bash(scripts/check.sh:*)",
      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(uvx clang-format@23.1.5:*)",
      "Bash(uvx clang-tidy@23.1.4:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/format-file.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/verify.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
